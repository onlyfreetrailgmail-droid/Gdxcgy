# Copy to .env for local dev. Never commit .env. In production set these in the host dashboard.
NODE_ENV=development
PORT=4001
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# CORS_ORIGINS=https://www.printxyz.in

# Secrets: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Production requires both, >=32 chars, and they must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Admin seed (one-time script). Password needs 12+ chars with upper, lower, digit, symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=printxyz

# Razorpay (webhook secret is set in the Razorpay dashboard, separate from the API key secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (private customer photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Meta Pixel id is public; the access token (Events Manager > Conversions API) must stay server-side only.
META_PIXEL_ID=
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Loads only after the visitor accepts cookies.
GA_MEASUREMENT_ID=
# Optional error monitoring. Personal data is stripped before sending.
SENTRY_DSN=
META_ACCESS_TOKEN=
# Set while testing in Events Manager > Test events, then clear it before launch.
META_TEST_EVENT_CODE=

# Only the production deployment is indexable. Set false to block search engines even in production (soft launch).
ALLOW_INDEXING=true
# Client build (Vercel): canonical site origin used in canonical tags and structured data.
VITE_SITE_URL=https://printxyz.in

# Local only. Ignored in production.
EXPOSE_DEV_OTP=false

SITE_NAME=Printxyz
# Public contact details: fill with real values, do not ship placeholders.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ---- Couriers (all optional; a courier with missing credentials is simply disabled) ----
# Shiprocket: panel > Settings > API > Configure > Create an API User (NOT your login email).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location NAME exactly as shown in Shiprocket (Settings > Pickup Addresses)
SHIPROCKET_PICKUP_LOCATION=
# Set the same value as the "token" in Shiprocket > Settings > API > Webhooks
SHIPROCKET_WEBHOOK_TOKEN=
# Delhivery: API token from your Delhivery account. Use staging first.
DELHIVERY_TOKEN=
DELHIVERY_MODE=staging
# Warehouse NAME exactly as registered with Delhivery (case-sensitive)
DELHIVERY_PICKUP_LOCATION=
# Long random value used in the Delhivery webhook URL path
DELHIVERY_WEBHOOK_SECRET=
# Your pickup pincode (needed for Shiprocket serviceability checks)
PICKUP_PINCODE=
# Default parcel when an order has no measured size
SHIPPING_DEFAULT_WEIGHT_KG=0.5
SHIPPING_DEFAULT_LENGTH_CM=15
SHIPPING_DEFAULT_BREADTH_CM=15
SHIPPING_DEFAULT_HEIGHT_CM=10

# Resend webhook signing secret (Resend dashboard > Webhooks). Optional; enables bounce/complaint handling.
RESEND_WEBHOOK_SECRET=

# Pricing (rupees). Shipping fee applies below the free-shipping threshold.
FREE_SHIPPING_THRESHOLD_RUPEES=1499
SHIPPING_FEE_RUPEES=0

# ---- Part (advance) payments and returns ----
# Percent charged up front on custom (photo) and bulk orders. 0 turns the feature off. Max 90.
ADVANCE_PERCENT=50
# Part payment is offered only when the order total is at least this many rupees.
ADVANCE_MIN_TOTAL_RUPEES=2000
# A line with at least this many units counts as a bulk order.
BULK_MIN_QUANTITY=10
# Days after delivery that a return can be requested. 0 turns returns off. Keep your Refund policy page in sync.
RETURN_WINDOW_DAYS=7

# ---- Alerts and uptime (see docs/MONITORING.md) ----
# Where payment-failure, webhook, email-backlog, refund and database alerts are sent (defaults to SUPPORT_EMAIL).
ALERT_EMAIL=
# Optional Slack / Discord / Teams incoming-webhook URL (https). Alerts are posted here as well.
ALERT_WEBHOOK_URL=
# Optional heartbeat URL from Healthchecks.io / BetterStack / UptimeRobot. Pinged every 5 minutes while the API and database are healthy.
UPTIME_HEARTBEAT_URL=

# ---- Hosting ----
# Proxies in front of the API: 1 = Render only (recommended). 2 = Vercel rewrites to Render. A wrong value makes every visitor share one IP for rate limits.
TRUST_PROXY_HOPS=1
# Global requests per minute per visitor IP.
RATE_LIMIT_PER_MIN=300
